@model List<Estadistica>
@{
    ViewData["Title"] = "Inicio";
}
<h1>Hola, @User.Identity?.Name</h1>
<p class="gf-subtitulo">Gestiona clientes, actividades y sesiones del centro de forma rápida y sencilla.</p>
<div class="gf-rejilla mt-4">
    <partial name="_Tarjeta" model='new Tarjeta("usuarios", "Clientes", "Gestiona los clientes del centro.")' />
    <partial name="_Tarjeta" model='new Tarjeta("actividad", "Actividades", "Consulta las actividades del centro.")' />
    <partial name="_Tarjeta" model='new Tarjeta("calendario", "Sesiones", "Consulta las sesiones y su disponibilidad.")' />
</div>
@if (ViewBag.Error != null)
{
    <div class="gf-aviso gf-aviso-error">@ViewBag.Error</div>
}
@if (Model.Count > 0)
{
    <h2 class="gf-seccion">Resumen del centro</h2>
    <div class="gf-rejilla">
        @foreach (var estadistica in Model)
        {
            <partial name="_Estadistica" model="estadistica" />
        }
    </div>
}