@model List<Estadistica>
@{
    ViewData["Title"] = "Inicio";
}
<h1>Hola, @User.Identity?.Name</h1>
<p class="gf-subtitulo">Organiza actividades, salas y sesiones para que el centro funcione cada día.</p>
<div class="gf-rejilla mt-4">
    <partial name="_Tarjeta" model='new Tarjeta("actividad", "Actividades", "Gestiona las actividades del centro.")' />
    <partial name="_Tarjeta" model='new Tarjeta("puerta", "Salas", "Gestiona las salas del centro.")' />
    <partial name="_Tarjeta" model='new Tarjeta("calendario", "Sesiones", "Gestiona las sesiones y sus reservas.")' />
    <partial name="_Tarjeta" model='new Tarjeta("entrenador", "Entrenadores", "Gestiona los entrenadores del centro.")' />
    <partial name="_Tarjeta" model='new Tarjeta("mancuerna", "Ejercicios", "Gestiona el catálogo de ejercicios.")' />
</div>
@if (ViewBag.Error != null)
{
    <div class="gf-aviso gf-aviso-error">@ViewBag.Error</div>
}
@if (Model.Count > 0)
{
    <h2 class="gf-seccion">Resumen del centro</h2>
    <div class="gf-rejilla">
        @foreach (var estadistica in Model)
        {
            <partial name="_Estadistica" model="estadistica" />
        }
    </div>
}