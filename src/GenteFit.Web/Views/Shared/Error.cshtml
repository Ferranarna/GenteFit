@{
    ViewData["Title"] = "Algo ha ido mal";
    ViewData["SinMenu"] = true;
}

<div class="gf-centrado">
    <div class="gf-tarjeta gf-error">
        <a class="gf-logo" asp-controller="Home" asp-action="Index">GENTE<span>FIT</span></a>
        <span class="gf-icono">@Iconos.Ver("alerta")</span>
        <h1>Algo ha ido mal</h1>
        <p>Ha ocurrido un error inesperado.<br />El fallo queda registrado para poder corregirlo.</p>
        <div class="gf-botones">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="gf-boton gf-boton-auto" asp-controller="Home" asp-action="Index">Volver al inicio</a>
            }
            else
            {
                <a class="gf-boton gf-boton-auto" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
            }
            @if (ViewBag.Ruta is string ruta)
            {
                <a class="gf-boton gf-boton-auto gf-boton-borde" href="@ruta">Reintentar</a>
            }
        </div>
    </div>
</div>