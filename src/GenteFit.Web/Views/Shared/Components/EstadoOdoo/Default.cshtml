@using System.Globalization
@model EstadoOdooViewModel
@{
    var es = new CultureInfo("es-ES");
    string Contar(int n, string uno, string varios) => $"{n} {(n == 1 ? uno : varios)}";
}

<div class="gf-rejilla gf-rejilla-informe mb-3">
    <div class="gf-tarjeta gf-estadistica">
        <span class="gf-icono">@Iconos.Ver("intercambio")</span>
        <small class="gf-estadistica-titulo">Servidor Odoo</small>
        <div class="gf-estadistica-valor">
            @if (Model.OdooDisponible)
            {
                <span class="gf-chip gf-chip-activo">Disponible</span>
            }
            else
            {
                <span class="gf-chip gf-chip-baja">No disponible</span>
            }
        </div>
        <div class="gf-estadistica-detalle">
            @Model.UrlOdoo
            @if (!Model.OdooDisponible)
            {
                <div role="note">Puedes seguir exportando y cargar el fichero más tarde.</div>
            }
        </div>
    </div>

    <div class="gf-tarjeta gf-estadistica">
        <span class="gf-icono">@Iconos.Ver("subir")</span>
        <small class="gf-estadistica-titulo">Última exportación</small>
        <div class="gf-estadistica-valor">@(Model.UltimaExportacion?.Generado.ToString("d MMM, HH:mm", es) ?? "Ninguna todavía")</div>
        <div class="gf-estadistica-detalle">
            <b>@Contar(Model.SesionesEnviadas, "sesión enviada", "sesiones enviadas")</b>
            en @Contar(Model.LotesEnviados, "lote", "lotes")
        </div>
    </div>

    <div class="gf-tarjeta gf-estadistica">
        <span class="gf-icono">@Iconos.Ver("descargar")</span>
        <small class="gf-estadistica-titulo">Última importación</small>
        <div class="gf-estadistica-valor">@(Model.UltimaImportacion?.Generado.ToString("d MMM, HH:mm", es) ?? "Ninguna todavía")</div>
        <div class="gf-estadistica-detalle">
            <b>@Contar(Model.SesionesRecibidas, "sesión recibida", "sesiones recibidas")</b>
            en @Contar(Model.LotesRecibidos, "lote", "lotes")
        </div>
    </div>
</div>