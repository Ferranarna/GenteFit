@model RutinaDetalleViewModel
@{
    ViewData["Title"] = Model.Rutina.NombreRutina;
    var detalles = Model.Detalles;
}

<div class="gf-cabecera">
    <h1>Rutina: @Model.Rutina.NombreRutina</h1>
    <div class="gf-herramientas">
        <a class="gf-boton-icono" asp-action="Index" aria-label="Volver a Mis rutinas" title="Volver">@Iconos.Ver("volver")</a>
    </div>
</div>

@if (TempData["Error"] is string error)
{
    <div class="gf-aviso gf-aviso-error" role="alert">@error</div>
}
@if (TempData["Ok"] is string ok)
{
    <div class="gf-aviso gf-aviso-ok" role="status">@ok</div>
}

@* Formulario vacío para quitar: los radios de cada fila se enlazan a él con form="form-quitar" *@
<form id="form-quitar" method="post" asp-action="Quitar">
    <input type="hidden" name="rutinaId" value="@Model.Rutina.RutinaId" />
</form>

<div class="gf-rutina-detalle">
    <form class="gf-tarjeta" method="post" asp-action="GuardarSeries">
        <input type="hidden" name="rutinaId" value="@Model.Rutina.RutinaId" />

        <div class="gf-cabecera mb-2">
            <h2 class="gf-titulo-tarjeta">Ejercicios de la rutina</h2>
            <button id="boton-quitar" class="gf-boton-icono gf-boton-icono-peligro" type="submit" form="form-quitar" disabled
                    onclick="return confirm('¿Quitar este ejercicio de la rutina?')"
                    aria-label="Quitar el ejercicio elegido" title="Quitar ejercicio">
                @Iconos.Ver("quitar")
            </button>
        </div>

        @if (detalles.Count == 0)
        {
            <p class="gf-ayuda">Esta rutina aún no tiene ejercicios. Añádelos desde el panel «Añadir ejercicio».</p>
        }
        else
        {
            <p class="gf-campo-ayuda">Las series y repeticiones deben ser mayores que 0. Elige una fila para quitarla.</p>
            <div class="table-responsive">
                <table class="gf-tabla gf-tabla-seleccion">
                    <caption class="visually-hidden">Ejercicios de la rutina con sus series y repeticiones</caption>
                    <thead>
                        <tr>
                            <th scope="col"><span class="visually-hidden">Elegir</span></th>
                            <th scope="col">Orden</th>
                            <th scope="col">Ejercicio</th>
                            <th scope="col">Series</th>
                            <th scope="col">Repeticiones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < detalles.Count; i++)
                        {
                            var d = detalles[i];
                            <tr>
                                <td>
                                    <input type="radio" name="detalleId" value="@d.DetalleRutinaId" form="form-quitar"
                                           aria-label="Elegir @d.Ejercicio.NombreEjercicio" />
                                </td>
                                <td>@d.Orden</td>
                                <td><strong>@d.Ejercicio.NombreEjercicio</strong></td>
                                <td>
                                    <input type="hidden" name="filas[@i].DetalleId" value="@d.DetalleRutinaId" />
                                    <input class="form-control gf-numero" type="number" min="1" max="99" required
                                           name="filas[@i].Series" value="@d.Series"
                                           aria-label="Series de @d.Ejercicio.NombreEjercicio" />
                                </td>
                                <td>
                                    <input class="form-control gf-numero" type="number" min="1" max="999" required
                                           name="filas[@i].Repeticiones" value="@d.Repeticiones"
                                           aria-label="Repeticiones de @d.Ejercicio.NombreEjercicio" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="gf-botones mt-3">
                <button class="gf-boton gf-boton-auto" type="submit">Guardar cambios</button>
            </div>
        }
    </form>

    <div class="gf-rutina-panel">
        <form class="gf-tarjeta" method="post" asp-action="Renombrar">
            <input type="hidden" name="rutinaId" value="@Model.Rutina.RutinaId" />
            <h2 class="gf-titulo-tarjeta">Nombre</h2>
            <label class="gf-etiqueta" for="nombre">Nombre de la rutina</label>
            <input class="form-control" id="nombre" name="nombre" value="@Model.Rutina.NombreRutina" required maxlength="100" />
            <button class="gf-boton gf-boton-borde gf-boton-auto mt-2" type="submit">Cambiar nombre</button>
        </form>

        <form class="gf-tarjeta" method="post" asp-action="Anadir">
            <input type="hidden" name="rutinaId" value="@Model.Rutina.RutinaId" />
            <h2 class="gf-titulo-tarjeta">Añadir ejercicio</h2>
            <label class="gf-etiqueta" for="ejercicioId">Ejercicio</label>
            <select class="form-select" id="ejercicioId" name="ejercicioId" required>
                <option value="">Selecciona un ejercicio</option>
                @foreach (var e in Model.Catalogo)
                {
                    <option value="@e.EjercicioId">@e.NombreEjercicio (@(e.GrupoMuscular ?? "sin grupo"))</option>
                }
            </select>
            <small class="gf-campo-ayuda">Se añade al final con 3 series de 10; luego puedes cambiarlas.</small>
            <button class="gf-boton-icono mt-2" type="submit" aria-label="Añadir el ejercicio elegido" title="Añadir">@Iconos.Ver("crear")</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Al elegir una fila se activa el botón Quitar
        const boton = document.getElementById('boton-quitar');
        const actualizar = () => boton.disabled = !document.querySelector('input[name="detalleId"]:checked');
        document.querySelectorAll('input[name="detalleId"]').forEach(r => r.addEventListener('change', actualizar));
        document.querySelectorAll('.gf-tabla-seleccion tbody tr').forEach(fila =>
            fila.addEventListener('click', e => {
                if (e.target.tagName === 'INPUT') return;   // escribir en series/repeticiones no elige la fila
                const radio = fila.querySelector('input[name="detalleId"]');
                radio.checked = true;
                actualizar();
            }));
        actualizar();
    </script>
}
