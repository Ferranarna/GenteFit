@{
    bool sinMenu = ViewData["SinMenu"] is true;
    string nombre = User.Identity?.Name ?? "";
    string inicial = nombre.Length > 0 ? nombre.Substring(0, 1).ToUpper() : "?";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GenteFit</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (!sinMenu)
    {
        <header>
            <nav class="navbar navbar-expand-lg gf-nav">
                <div class="container-fluid">
                    <a class="gf-logo" asp-controller="Home" asp-action="Index">GENTE<span>FIT</span></a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                            data-bs-target="#menuPrincipal" aria-label="Abrir menú">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="menuPrincipal">
                        <ul class="navbar-nav me-auto ms-lg-4">
                            <li class="nav-item">
                                <a class="nav-link activo" asp-controller="Home" asp-action="Index">Inicio</a>
                            </li>
                        </ul>
                        <div class="dropdown">
                            <button class="gf-usuario dropdown-toggle" data-bs-toggle="dropdown">
                                <span class="gf-avatar">@inicial</span> @nombre
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Cuenta" asp-action="CambiarContrasena">Cambiar contraseña</a></li>
                                <li>
                                    <form asp-controller="Cuenta" asp-action="Logout" method="post">
                                        <button class="dropdown-item" type="submit">Cerrar sesión</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }
    <main class="@(sinMenu ? "" : "gf-contenido")">
        @RenderBody()
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>