@{
    ViewData["Title"] = "Gestión de Odoo";
}

<h1>Gestión de Odoo (ERP)</h1>

<div class="gf-aviso gf-aviso-info" id="aviso-odoo" role="note">
    En construcción
</div>

<div class="row g-3 mt-1">
    <section class="col-lg-6" aria-labelledby="titulo-estado">
        <div class="gf-tarjeta h-100">
            <h2 id="titulo-estado" class="gf-titulo-tarjeta">Estado de la integración</h2>

            <div class="gf-estado-fila">
                <div>
                    <strong>Conexión con Odoo</strong>
                    <small>Estado de la conexión con el ERP</small>
                </div>
                <span class="gf-chip gf-chip-apagado">Por definir</span>
            </div>

            <div class="gf-estado-fila">
                <div>
                    <strong>Última exportación / importación</strong>
                    <small>Fecha y resultado</small>
                </div>
                <span class="gf-chip gf-chip-apagado" aria-label="Ninguna todavía">—</span>
            </div>
        </div>
    </section>

    <section class="col-lg-6" aria-labelledby="titulo-acciones">
        <div class="gf-tarjeta h-100">
            <h2 id="titulo-acciones" class="gf-titulo-tarjeta">Acciones</h2>

            <div class="gf-odoo-acciones">
                <button class="gf-boton gf-boton-auto" type="button" disabled aria-describedby="aviso-odoo">
                    Exportar datos a Odoo (XML)
                </button>
                <button class="gf-boton gf-boton-borde gf-boton-auto" type="button" disabled aria-describedby="aviso-odoo">
                    Importar datos desde Odoo (XML)
                </button>
            </div>
        </div>
    </section>
</div>