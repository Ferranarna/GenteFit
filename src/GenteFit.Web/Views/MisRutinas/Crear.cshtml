@model NuevaRutinaViewModel
@{
    ViewData["Title"] = "Nueva rutina";
}

<div class="gf-estrecho">
    <h1>Nueva rutina</h1>
    <p class="gf-subtitulo">Ponle un nombre. Después podrás añadirle ejercicios.</p>

    <form class="gf-tarjeta" method="post" asp-action="Crear">
        <label class="gf-etiqueta" asp-for="Nombre">Nombre de la rutina</label>
        <input class="form-control" asp-for="Nombre" placeholder="Ej. Pierna y glúteo" autofocus />
        <span class="gf-campo-error" asp-validation-for="Nombre"></span>

        @if (ViewBag.Error != null)
        {
            <div class="gf-aviso gf-aviso-error" role="alert">@ViewBag.Error</div>
        }
        else
        {
            <div class="gf-aviso gf-aviso-info">Introduce los datos.</div>
        }
        <div asp-validation-summary="ModelOnly" class="gf-aviso gf-aviso-error" role="alert"></div>

        <div class="gf-botones mt-3">
            <button class="gf-boton gf-boton-auto" type="submit">Crear</button>
            <a class="gf-boton gf-boton-borde gf-boton-auto" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}