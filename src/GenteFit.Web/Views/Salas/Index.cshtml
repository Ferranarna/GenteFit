@model SalasViewModel
@{
    ViewData["Title"] = "Salas";
}

<div class="gf-cabecera">
    <h1>Salas</h1>
    <div class="gf-herramientas">
        <button id="boton-modificar" class="gf-boton-icono" type="submit" form="form-sala" disabled
                aria-label="Modificar la sala elegida" title="Modificar">
            @Iconos.Ver("modificar")
        </button>
        <a class="gf-boton-icono" asp-action="Crear"
           aria-label="Crear una sala nueva" title="Crear sala">@Iconos.Ver("crear")</a>
        <a class="gf-boton-icono" asp-action="Informe"
           aria-label="Informe de uso de salas" title="Informe">@Iconos.Ver("informe")</a>
    </div>
</div>

<form class="gf-buscador" method="get" asp-action="Index" role="search">
    <input class="form-control" type="search" name="buscar" value="@Model.Buscar"
           placeholder="Buscar sala por nombre" aria-label="Buscar sala por nombre" />
    <button class="gf-boton gf-boton-borde gf-boton-auto" type="submit">Buscar</button>
</form>

@if (ViewBag.Error != null)
{
    <div class="gf-aviso gf-aviso-error" role="alert">@ViewBag.Error</div>
}
@if (TempData["Error"] is string error)
{
    <div class="gf-aviso gf-aviso-error" role="alert">@error</div>
}
@if (TempData["Ok"] is string ok)
{
    <div class="gf-aviso gf-aviso-ok" role="status">@ok</div>
}

@if (Model.Salas.Count == 0 && ViewBag.Error == null)
{
    <div class="gf-tarjeta">
        <p class="gf-ayuda">
            @(string.IsNullOrWhiteSpace(Model.Buscar)
                ? "Todavía no hay salas."
                : $"No hay ninguna sala que contenga «{Model.Buscar}».")
        </p>
    </div>
}
else if (Model.Salas.Count > 0)
{
    <form id="form-sala" class="gf-tarjeta" method="get" asp-action="Editar">
        <div class="table-responsive">
            <table class="gf-tabla gf-tabla-seleccion">
                <caption class="visually-hidden">Salas del centro. Elige una fila y pulsa Modificar.</caption>
                <thead>
                    <tr>
                        <th scope="col"><span class="visually-hidden">Elegir</span></th>
                        <th scope="col">Sala</th>
                        <th scope="col">Ubicación</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Salas)
                    {
                        <tr>
                            <td>
                                <input type="radio" name="salaId" value="@s.SalaId" aria-label="Elegir @s.NombreSala" />
                            </td>
                            <td><strong>@s.NombreSala</strong></td>
                            <td>@SalasViewModel.TextoUbicacion(s.Ubicacion)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
}

@section Scripts {
    <script>
        // Al elegir una fila se activa el botón Modificar (guía del equipo: sin columna de acciones)
        const boton = document.getElementById('boton-modificar');
        const actualizar = () => boton.disabled = !document.querySelector('input[name="salaId"]:checked');

        document.querySelectorAll('input[name="salaId"]').forEach(radio =>
            radio.addEventListener('change', actualizar));

        document.querySelectorAll('.gf-tabla-seleccion tbody tr').forEach(fila =>
            fila.addEventListener('click', e => {
                const radio = fila.querySelector('input[name="salaId"]');
                if (radio && e.target !== radio) {
                    radio.checked = true;
                    actualizar();
                }
            }));

        actualizar();
    </script>
}
