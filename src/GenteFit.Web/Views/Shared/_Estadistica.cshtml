@model Estadistica
@{
    var partes = Model.Detalle.Split("{0}");
}

<div class="gf-tarjeta gf-estadistica">
    <span class="gf-icono">@Iconos.Ver(Model.Icono)</span>
    <small class="gf-estadistica-titulo">@Model.Titulo</small>
    <div class="gf-estadistica-valor">@Model.Valor</div>
    @if (Model.Porcentaje is int porcentaje)
    {
        <div class="gf-barra"><i style="width:@(porcentaje)%"></i></div>
    }
    <div class="gf-estadistica-detalle">
        @partes[0]@if (partes.Length > 1)
        {
            <b>@Model.Resaltado</b>
            @partes[1]
        }
    </div>
    <a class="gf-estadistica-enlace" href="@Model.Enlace">@Model.TextoEnlace @Iconos.Ver("flecha")</a>
</div>