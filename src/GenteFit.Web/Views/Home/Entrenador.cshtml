    <partial name="_Tarjeta" model='new Tarjeta("calendario", "Mis sesiones", "Consulta tus sesiones y sus reservas.")' />
    <partial name="_Tarjeta" model='new Tarjeta("mancuerna", "Ejercicios", "Consulta los ejercicios disponibles.")' />
    <partial name="_Tarjeta" model='new Tarjeta("reloj", "Mis citas", "Organiza tus citas con tus clientes.")' />
