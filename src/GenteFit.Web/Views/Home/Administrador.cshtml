@model List<Estadistica>
@{
    ViewData["Title"] = "Centro de mando";
}
<h1>Centro de mando</h1>
<p class="gf-subtitulo">Hola, @User.Identity?.Name. Desde aquí accedes a todas las funciones del centro.</p>
<div class="gf-rejilla mt-4">
    @foreach (var tarjeta in Menus.CentroDeMando)
    {
        <partial name="_Tarjeta" model="tarjeta" />
    }
</div>
@if (ViewBag.Error != null)
{
    <div class="gf-aviso gf-aviso-error">@ViewBag.Error</div>
}
@if (Model.Count > 0)
{
    <h2 class="gf-seccion">Resumen del centro</h2>
    <div class="gf-rejilla">
        @foreach (var estadistica in Model)
        {
            <partial name="_Estadistica" model="estadistica" />
        }
    </div>
}