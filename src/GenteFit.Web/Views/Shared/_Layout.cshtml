@{
    bool sinMenu = ViewData["SinMenu"] is true;
    string nombre = User.Identity?.Name ?? "";
    string ruta = Context.Request.Path.Value ?? "/";
    string inicial = nombre.Length > 0 ? nombre.Substring(0, 1).ToUpper() : "?";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GenteFit</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (!sinMenu)
    {
        <header>
            <nav class="navbar navbar-expand-xl gf-nav">
                <div class="container-fluid">
                    <a class="gf-logo" asp-controller="Home" asp-action="Index">GENTE<span>FIT</span></a>

                    <div class="d-flex align-items-center gap-2 ms-auto order-xl-3">
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                                data-bs-target="#menuPrincipal" aria-label="Abrir menú">
                            @Iconos.Ver("menu")
                        </button>
                        <div class="dropdown">
                            <button class="gf-usuario dropdown-toggle" data-bs-toggle="dropdown" data-bs-display="static">
                                <span class="gf-avatar">@inicial</span>
                                <span class="d-none d-xl-inline">@nombre</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (User.IsInRole("Cliente"))
                                {
                                    <li><a class="dropdown-item" asp-controller="Cuenta" asp-action="MisDatos">@Iconos.Ver("usuario") Mis datos</a></li>
                                }
                                <li><a class="dropdown-item" asp-controller="Cuenta" asp-action="CambiarContrasena">@Iconos.Ver("candado") Cambiar contraseña</a></li>
                                <li>
                                    <form asp-controller="Cuenta" asp-action="Logout" method="post">
                                        <button class="dropdown-item" type="submit">@Iconos.Ver("cerrar-sesion") Cerrar sesión</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="collapse navbar-collapse order-xl-2" id="menuPrincipal">
                        <ul class="navbar-nav mx-xl-auto">
                            <li class="nav-item">
                                <a class="nav-link @(ruta == "/" || ruta.StartsWith("/Home", StringComparison.OrdinalIgnoreCase) ? "activo" : "")"
                                   asp-controller="Home" asp-action="Index">Inicio</a>
                            </li>
                            @foreach (var pantalla in Menus.De(User))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ruta.StartsWith(pantalla.Url, StringComparison.OrdinalIgnoreCase) ? "activo" : "")"
                                       href="@pantalla.Url">@pantalla.Titulo</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }
    <main class="@(sinMenu ? "" : "gf-contenido")">
        @RenderBody()
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Solo un panel abierto a la vez: el de pestañas o el del usuario
        const menu = document.getElementById('menuPrincipal');
        const usuario = document.querySelector('.gf-nav [data-bs-toggle="dropdown"]');
        if (menu && usuario) {
            usuario.addEventListener('show.bs.dropdown', () => bootstrap.Collapse.getInstance(menu)?.hide());
            menu.addEventListener('show.bs.collapse', () => bootstrap.Dropdown.getInstance(usuario)?.hide());
        }
    </script>
    <template id="gf-chevron">@Iconos.Ver("chevron")</template>
    <script>
        // Cada desplegable (<select class="form-select">) se ve como el menú del usuario.
        // El <select> original sigue ahí, oculto: guarda el valor y sigue enviándose con su formulario.
        document.querySelectorAll('select.form-select').forEach(select => {
            const caja = document.createElement('div');
            caja.className = 'dropdown gf-desplegable';

            const boton = document.createElement('button');
            boton.type = 'button';
            boton.className = 'gf-desplegable-boton';
            boton.disabled = select.disabled;
            boton.setAttribute('data-bs-toggle', 'dropdown');
            boton.setAttribute('aria-expanded', 'false');
            boton.setAttribute('aria-label', select.getAttribute('aria-label') ?? '');
            const texto = document.createElement('span');
            boton.append(texto, document.getElementById('gf-chevron').content.cloneNode(true));

            const lista = document.createElement('ul');
            lista.className = 'dropdown-menu';

            const pintar = () => {
                texto.textContent = select.selectedOptions[0]?.textContent.trim() ?? '';
                lista.querySelectorAll('.dropdown-item').forEach((item, i) =>
                    item.classList.toggle('activo', select.options[i].selected));
            };

            Array.from(select.options).forEach(opcion => {
                const item = document.createElement('button');
                item.type = 'button';
                item.className = 'dropdown-item';
                item.textContent = opcion.textContent.trim();
                item.addEventListener('click', () => {
                    select.value = opcion.value;
                    pintar();
                    select.dispatchEvent(new Event('change', { bubbles: true }));
                });
                const fila = document.createElement('li');
                fila.append(item);
                lista.append(fila);
            });

            caja.append(boton, lista);
            // El menú flota por encima de todo (así una tabla con scroll no lo recorta) y se abre hacia arriba si abajo no cabe
            new bootstrap.Dropdown(boton, { popperConfig: { strategy: 'fixed' } });
            // Flotando, el "100%" sería el de la pantalla; por eso se le da el ancho del botón al abrirlo
            boton.addEventListener('show.bs.dropdown', () => lista.style.minWidth = boton.offsetWidth + 'px');
            select.classList.add('gf-select-oculto');
            select.after(caja);
            pintar();
        });
    </script>
    <script>
        // Tablas con la clase "gf-tabla-ordenable": al pulsar el título de una columna, se ordena por ella.
        document.querySelectorAll('table.gf-tabla-ordenable').forEach(tabla => {
            const cuerpo = tabla.tBodies[0];
            if (!tabla.tHead || !cuerpo) return;
            const titulos = Array.from(tabla.tHead.rows[0].cells);
            const esNumero = texto => /^-?\d+([.,]\d+)?\s*%?$/.test(texto);

            titulos.forEach((titulo, columna) => {
                const lleva = Array.from(cuerpo.rows).some(fila => fila.cells[columna]?.querySelector('input'));
                if (lleva || titulo.hasAttribute('data-no-ordenar')) return;

                const boton = document.createElement('button');
                boton.type = 'button';
                boton.className = 'gf-ordenar';
                boton.append(...titulo.childNodes);
                titulo.append(boton);

                boton.addEventListener('click', () => {
                    const ascendente = titulo.getAttribute('aria-sort') !== 'ascending';
                    titulos.forEach(t => t.removeAttribute('aria-sort'));
                    titulo.setAttribute('aria-sort', ascendente ? 'ascending' : 'descending');

                    const valor = fila => fila.cells[columna]?.textContent.trim() ?? '';
                    const filas = Array.from(cuerpo.rows).sort((a, b) => {
                        const x = valor(a), y = valor(b);
                        const orden = esNumero(x) && esNumero(y)
                            ? parseFloat(x.replace(',', '.')) - parseFloat(y.replace(',', '.'))
                            : x.localeCompare(y, 'es', { sensitivity: 'base', numeric: true });
                        return ascendente ? orden : -orden;
                    });
                    cuerpo.append(...filas);
                });
            });
        });
    </script>

    <script>
        const errorBaseDeDatos = @Html.Raw(Json.Serialize(Errores.ErrorBaseDeDatos));
        document.querySelectorAll('.gf-aviso-ok, .gf-aviso-error').forEach(aviso => {
            const esOk = aviso.classList.contains('gf-aviso-ok');
            if (!esOk && (aviso.closest('form') || aviso.textContent.trim() === errorBaseDeDatos)) return;

            setTimeout(() => {
                aviso.classList.add('gf-aviso-saliendo');
                aviso.addEventListener('transitionend', () => {
                    const contenedor = aviso.parentElement;
                    aviso.remove();
                    if (contenedor.id === 'avisos' && contenedor.children.length === 0) contenedor.remove();
                }, { once: true });
            }, esOk ? 4000 : 7000);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>